# Base address of the Nexa API, including /api. (Baked in at build time.)
NEXT_PUBLIC_API_URL=https://search-engine-api-gilt.vercel.app/api

# Where to send people after signing in when the page was opened without a ?return= address
# (for example if someone types this app's address directly). This must be the main UI's
# /auth/callback address, and its origin must be listed in the API's AUTH_ALLOWED_ORIGINS.
NEXT_PUBLIC_DEFAULT_RETURN_URL=https://search-engine-ui-eight.vercel.app/auth/callback
